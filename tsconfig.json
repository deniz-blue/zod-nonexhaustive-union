{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"incremental": false,
		"isolatedModules": true,
		"module": "esnext",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": false,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"verbatimModuleSyntax": true,
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}